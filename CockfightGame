import javax.swing.*;
import java.awt.*;
import java.awt.event.*;
import java.util.ArrayList;
import java.util.Iterator;
import java.util.Random;

public class CockfightGame {
    public static void main(String[] args) {
        JFrame window = new JFrame("Java Cockfight RPG - Portals & Enrage");
        window.setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
        window.setResizable(false);
        GameEngine gameEngine = new GameEngine();
        window.add(gameEngine);
        window.pack();
        window.setLocationRelativeTo(null);
        window.setVisible(true);
        gameEngine.startGame();
    }
}

class GameEngine extends JPanel implements Runnable, KeyListener, MouseListener, MouseMotionListener {
    enum GameState { MENU, SELECT, EXPLORE, BATTLE, VICTORY, GAMEOVER }
    GameState state = GameState.MENU;
    
    enum BattlePhase { PLAYER_TURN, AIMING, PLAYER_MOVING, BOSS_TURN, BOSS_MOVING }
    BattlePhase bPhase = BattlePhase.PLAYER_TURN;
    
    public enum BuffType { HEAL, DAMAGE_X2, SPEED_UP }
    
    int width = 800, height = 600;
    Thread gameThread;
    boolean running = false;
    static Random random = new Random();

    int playerX = 400, playerY = 300, playerSpeed = 4;
    boolean up, down, left, right;
    
    Image bgImg = new ImageIcon("bg.png").getImage();

    ArrayList<HeroChicken> availableChickens = new ArrayList<>();
    ArrayList<HeroChicken> myChickens = new ArrayList<>();
    BossChicken enemy;
    
    ArrayList<EggMine> eggMines = new ArrayList<>(); 
    ArrayList<BuffItem> activeBuffs = new ArrayList<>();
    ArrayList<DamageText> damageTexts = new ArrayList<>();
    
    ArrayList<Obstacle> obstacles = new ArrayList<>();
    ArrayList<Portal> portals = new ArrayList<>(); // เพิ่มลิสต์เก็บหลุมวาร์ป
    static ArrayList<Particle> particles = new ArrayList<>();
    
    Rectangle arena = new Rectangle(200, 150, 400, 300);
    
    HeroChicken selectedChicken = null;
    int dragX, dragY;
    int turnCounter = 0; 
    
    public static int shakeTimer = 0;
    public static int hitStopTimer = 0;

    public GameEngine() {
        setPreferredSize(new Dimension(width, height));
        setBackground(Color.BLACK);
        setFocusable(true);
        addKeyListener(this); addMouseListener(this); addMouseMotionListener(this); 

        availableChickens.add(new TankyChicken());
        availableChickens.add(new SpeedyChicken());
        availableChickens.add(new BalancedChicken());
        
        enemy = new BossChicken(400, 250);
    }

    public void startGame() { running = true; gameThread = new Thread(this); gameThread.start(); }
    
    public static void spawnParticles(double px, double py, Color c, int amount) {
        for (int i = 0; i < amount; i++) {
            double angle = random.nextDouble() * 2 * Math.PI;
            double speed = 2 + random.nextDouble() * 5;
            particles.add(new Particle(px, py, speed * Math.cos(angle), speed * Math.sin(angle), c));
        }
    }

    private void resetGame() {
        myChickens.clear(); enemy = new BossChicken(400, 250); 
        eggMines.clear(); activeBuffs.clear(); damageTexts.clear();
        obstacles.clear(); portals.clear(); particles.clear();
        playerX = 400; playerY = 300; turnCounter = 0; shakeTimer = 0; hitStopTimer = 0;
        state = GameState.MENU;
    }

    @Override
    public void run() {
        double drawInterval = 1000000000.0 / 60;
        double nextDrawTime = System.nanoTime() + drawInterval;
        while (running) {
            update(); repaint();
            try {
                double remainingTime = (nextDrawTime - System.nanoTime()) / 1000000;
                if (remainingTime > 0) Thread.sleep((long) remainingTime);
                nextDrawTime += drawInterval;
            } catch (InterruptedException e) {}
        }
    }

    private void update() {
        if (state == GameState.EXPLORE) {
            updateExplore();
        } else if (state == GameState.BATTLE) {
            if (hitStopTimer > 0) { hitStopTimer--; return; }
            updateBattle();
            if (shakeTimer > 0) shakeTimer--;
        }
    }

    private void updateExplore() {
        if (up) playerY -= playerSpeed; if (down) playerY += playerSpeed;
        if (left) playerX -= playerSpeed; if (right) playerX += playerSpeed;

        for (int i = 0; i < myChickens.size(); i++) {
            HeroChicken c = myChickens.get(i);
            int targetX = (i == 0) ? playerX : myChickens.get(0).getX();
            int targetY = (i == 0) ? playerY : myChickens.get(0).getY();
            c.followTarget(targetX, targetY);
        }
        if (enemy.isCollidingWithPoint(playerX, playerY, 40)) startBattle();
    }

    private void updateBattle() {
        enemy.updatePhysics(arena, eggMines);
        enemy.handleObstacles(obstacles); 
        enemy.handlePortals(portals); // บอสเช็คการวาร์ป
        
        Iterator<Particle> ptIter = particles.iterator();
        while (ptIter.hasNext()) {
            Particle pt = ptIter.next(); pt.update();
            if (pt.life <= 0) ptIter.remove();
        }
        
        for (int i = 0; i < myChickens.size(); i++) {
            HeroChicken c1 = myChickens.get(i);
            if (c1.isAlive()) {
                c1.updatePhysics(arena, eggMines);
                c1.handleObstacles(obstacles); 
                c1.handlePortals(portals); // ไก่เช็คการวาร์ป
                c1.checkCollisionWith(enemy, damageTexts);
                
                for (int j = i + 1; j < myChickens.size(); j++) {
                    HeroChicken c2 = myChickens.get(j);
                    if (c2.isAlive() && c1.isCollidingWith(c2)) {
                        double dx = (c1.x + c1.size/2.0) - (c2.x + c2.size/2.0), dy = (c1.y + c1.size/2.0) - (c2.y + c2.size/2.0);
                        double dist = Math.hypot(dx, dy), overlap = ((c1.size + c2.size)/2.0) - dist;
                        if (overlap > 0) { c1.x += (dx/dist) * overlap/2.0; c1.y += (dy/dist) * overlap/2.0; c2.x -= (dx/dist) * overlap/2.0; c2.y -= (dy/dist) * overlap/2.0; }
                        double tempVx = c1.vx, tempVy = c1.vy; c1.vx = c2.vx; c1.vy = c2.vy; c2.vx = tempVx; c2.vy = tempVy;
                        spawnParticles(c1.x + c1.size/2, c1.y + c1.size/2, Color.WHITE, 5); 
                    }
                }
            }
        }
        
        boolean anyoneMoving = enemy.isMoving();
        for (HeroChicken c : myChickens) if (c.isAlive() && c.isMoving()) anyoneMoving = true;

        if (bPhase == BattlePhase.PLAYER_MOVING) {
            if (!anyoneMoving) bPhase = BattlePhase.BOSS_TURN; 
        } else if (bPhase == BattlePhase.BOSS_TURN) {
            HeroChicken target = null; double minDist = Double.MAX_VALUE;
            for (HeroChicken c : myChickens) {
                if (c.isAlive()) {
                    double d = Math.hypot(c.x - enemy.x, c.y - enemy.y);
                    if (d < minDist) { minDist = d; target = c; }
                }
            }
            double angle = (target != null) ? Math.atan2(target.y - enemy.y, target.x - enemy.x) + (random.nextDouble() - 0.5) * 0.3 : random.nextDouble() * 2 * Math.PI;
            
            // --- ถ้าร่างโกรธ จะพุ่งเร็วและแรงขึ้น ---
            double bossPower = enemy.enraged ? 25.0 : 17.0; 
            enemy.vx = bossPower * Math.cos(angle); enemy.vy = bossPower * Math.sin(angle);
            bPhase = BattlePhase.BOSS_MOVING;
        } else if (bPhase == BattlePhase.BOSS_MOVING) {
            if (!anyoneMoving) {
                bPhase = BattlePhase.PLAYER_TURN; turnCounter++;
                for (HeroChicken c : myChickens) if (c.isAlive()) { if (c.skillCooldown > 0) c.skillCooldown--; c.resetSkill(); }
                if (turnCounter % 2 == 0) activeBuffs.add(new BuffItem(arena.x + 20 + random.nextInt(arena.width - 40), arena.y + 20 + random.nextInt(arena.height - 40)));
            }
        }

        Iterator<EggMine> mIter = eggMines.iterator();
        while (mIter.hasNext()) {
            EggMine m = mIter.next();
            if (enemy.isAlive() && enemy.isCollidingWith(m)) {
                enemy.takeDamage(25, damageTexts);
                enemy.vx = 0; enemy.vy = 0; 
                GameEngine.shakeTimer = 15; GameEngine.hitStopTimer = 8;
                spawnParticles(m.x + m.size/2, m.y + m.size/2, new Color(255,100,50), 30); 
                mIter.remove();
            }
        }
        
        Iterator<BuffItem> bIter = activeBuffs.iterator();
        while (bIter.hasNext()) {
            BuffItem b = bIter.next();
            for (HeroChicken c : myChickens) {
                if (c.isAlive() && c.isCollidingWith(b)) { b.applyBuffTo(c, damageTexts); bIter.remove(); break; }
            }
        }

        Iterator<DamageText> dtIter = damageTexts.iterator();
        while (dtIter.hasNext()) {
            DamageText dt = dtIter.next(); dt.update();
            if (dt.isDead()) dtIter.remove();
        }

        if (!enemy.isAlive()) state = GameState.VICTORY;
        boolean allDead = true; for (HeroChicken c : myChickens) if (c.isAlive()) allDead = false;
        if (allDead) state = GameState.GAMEOVER;
    }

    private void startBattle() {
        state = GameState.BATTLE; bPhase = BattlePhase.PLAYER_TURN;
        activeBuffs.clear(); eggMines.clear(); obstacles.clear(); portals.clear(); particles.clear(); turnCounter = 0;
        enemy.spawnInArena(500, 250); 
        int startY = 200;
        for (HeroChicken c : myChickens) { c.spawnInArena(250, startY); c.skillCooldown = 0; c.resetSkill(); startY += 80; }
        
        int obsCount = 1 + random.nextInt(3); 
        for (int i = 0; i < obsCount; i++) {
            boolean valid = false; int ox = 0, oy = 0, attempts = 0;
            while (!valid && attempts < 100) {
                ox = arena.x + 50 + random.nextInt(arena.width - 100); oy = arena.y + 50 + random.nextInt(arena.height - 100);
                if (Math.hypot(ox - 500, oy - 250) > 60 && Math.hypot(ox - 250, oy - 200) > 80 && Math.hypot(ox - 250, oy - 280) > 80) {
                    valid = true;
                    for (Obstacle o : obstacles) if (Math.hypot(ox - o.x, oy - o.y) < 60) valid = false;
                }
                attempts++;
            }
            if (valid) obstacles.add(new Obstacle(ox, oy, 35));
        }
        
        // --- สุ่มสร้างหลุมวาร์ป 1 คู่ (2 หลุม) ที่ลิงก์กัน ---
        Portal[] pair = new Portal[2];
        for (int i = 0; i < 2; i++) {
            boolean valid = false; int px = 0, py = 0, attempts = 0;
            while (!valid && attempts < 100) {
                px = arena.x + 40 + random.nextInt(arena.width - 80); py = arena.y + 40 + random.nextInt(arena.height - 80);
                valid = true;
                if (Math.hypot(px - 500, py - 250) < 70) valid = false; // ห้ามทับจุดเกิดบอส
                for (Obstacle o : obstacles) if (Math.hypot(px - o.x, py - o.y) < 60) valid = false;
                if (i == 1 && Math.hypot(px - pair[0].x, py - pair[0].y) < 100) valid = false; // หลุมวาร์ปต้องห่างกัน
                attempts++;
            }
            pair[i] = new Portal(px, py, 45);
            portals.add(pair[i]);
        }
        pair[0].linkedPortal = pair[1]; // ลิงก์หลุม 1 ไป 2
        pair[1].linkedPortal = pair[0]; // ลิงก์หลุม 2 ไป 1
    }

    @Override
    public void paintComponent(Graphics g) {
        super.paintComponent(g);
        Graphics2D g2 = (Graphics2D) g;
        g2.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);
        g2.setRenderingHint(RenderingHints.KEY_TEXT_ANTIALIASING, RenderingHints.VALUE_TEXT_ANTIALIAS_ON);
        
        int ox = 0, oy = 0;
        if (state == GameState.BATTLE && shakeTimer > 0) {
            ox = random.nextInt(14) - 7; oy = random.nextInt(14) - 7;
            g2.translate(ox, oy);
        }
        
        if (state == GameState.MENU) drawMenu(g2);
        else if (state == GameState.SELECT) drawSelection(g2);
        else if (state == GameState.EXPLORE) drawExplore(g2);
        else if (state == GameState.BATTLE) drawBattle(g2);
        else if (state == GameState.VICTORY) drawEndScreen(g2, "VICTORY!", new Color(255, 215, 0));
        else if (state == GameState.GAMEOVER) drawEndScreen(g2, "GAME OVER", new Color(255, 50, 50));
        
        if (state == GameState.BATTLE && shakeTimer > 0) g2.translate(-ox, -oy);
    }
    
    private void drawGradientBG(Graphics2D g2, Color top, Color bottom) {
        GradientPaint gp = new GradientPaint(0, 0, top, 0, height, bottom);
        g2.setPaint(gp); g2.fillRect(0, 0, width, height);
    }

