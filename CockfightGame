    private void drawSelection(Graphics2D g2) {
        drawGradientBG(g2, new Color(30, 40, 60), new Color(15, 20, 35));
        g2.setColor(Color.WHITE); g2.setFont(new Font("Arial", Font.BOLD, 36)); 
        g2.drawString("Select 2 Chickens (" + myChickens.size() + "/2)", 200, 80);
        for (int i = 0; i < availableChickens.size(); i++) availableChickens.get(i).drawPortrait(g2, 120 + (i * 220), 180, 120);
    }

    private void drawExplore(Graphics2D g2) {
        drawGradientBG(g2, new Color(40, 50, 40), new Color(20, 30, 20));
        g2.setColor(new Color(255, 255, 255, 15));
        for(int i = 0; i < width; i += 40) g2.drawLine(i, 0, i, height);
        for(int i = 0; i < height; i += 40) g2.drawLine(0, i, width, i);
        enemy.drawExploration(g2);
        for (HeroChicken c : myChickens) c.draw(g2);
        g2.setColor(Color.CYAN); g2.fillRoundRect(playerX, playerY, 30, 30, 10, 10);
        g2.setColor(Color.WHITE); g2.setFont(new Font("Arial", Font.BOLD, 12)); g2.drawString("You (WASD)", playerX - 20, playerY - 10);
    }

    private void drawBattle(Graphics2D g2) {
        drawGradientBG(g2, new Color(20, 20, 20), new Color(40, 40, 40));
        if (bgImg != null && bgImg.getWidth(null) > 0) g2.drawImage(bgImg, arena.x, arena.y, arena.width, arena.height, null);
        else { g2.setColor(new Color(60, 70, 60)); g2.fillRoundRect(arena.x, arena.y, arena.width, arena.height, 20, 20); }
        
        g2.setStroke(new BasicStroke(6)); g2.setColor(new Color(180, 180, 180)); g2.drawRoundRect(arena.x, arena.y, arena.width, arena.height, 20, 20);
        g2.setStroke(new BasicStroke(1)); 
        
        for (Portal p : portals) p.draw(g2); // วาดหลุมวาร์ปมิติ
        for (Obstacle o : obstacles) o.draw(g2); 
        for (EggMine m : eggMines) m.draw(g2);
        for (BuffItem b : activeBuffs) b.draw(g2);
        enemy.draw(g2);
        for (HeroChicken c : myChickens) if (c.isAlive()) c.draw(g2);
        
        for (Particle p : particles) p.draw(g2); 
        for (DamageText dt : damageTexts) dt.draw(g2);
        
        if (bPhase == BattlePhase.AIMING && selectedChicken != null) {
            int cx = selectedChicken.getX() + selectedChicken.size / 2; int cy = selectedChicken.getY() + selectedChicken.size / 2;
            Stroke dashed = new BasicStroke(3, BasicStroke.CAP_BUTT, BasicStroke.JOIN_BEVEL, 0, new float[]{9}, 0); g2.setStroke(dashed);
            g2.setColor(new Color(255, 255, 255, 180)); g2.drawLine(cx, cy, dragX, dragY); 
            g2.setColor(new Color(255, 50, 50, 200));
            
            double dx = cx - dragX, dy = cy - dragY; double dragDist = Math.hypot(dx, dy);
            if (dragDist > 0) {
                double dirX = dx / dragDist, dirY = dy / dragDist;
                double maxPower = 22.0, rawPower = dragDist * 0.035 * selectedChicken.speed, finalPower = Math.min(rawPower, maxPower), remainLen = finalPower * 16.0; 
                double currX = cx, currY = cy; int r = selectedChicken.size / 2; 
                int minX = arena.x + r, maxX = arena.x + arena.width - r, minY = arena.y + r, maxY = arena.y + arena.height - r;
                int bounces = 0;
                
                while (remainLen > 0 && bounces < 4) {
                    double nextX = currX + dirX * remainLen, nextY = currY + dirY * remainLen;
                    double tX = 9999, tY = 9999;
                    if (dirX > 0 && nextX > maxX) tX = (maxX - currX) / dirX; else if (dirX < 0 && nextX < minX) tX = (minX - currX) / dirX;
                    if (dirY > 0 && nextY > maxY) tY = (maxY - currY) / dirY; else if (dirY < 0 && nextY < minY) tY = (minY - currY) / dirY;
                    double tHit = Math.min(tX, tY); 
                    if (tHit < remainLen) {
                        double hitX = currX + dirX * tHit, hitY = currY + dirY * tHit;
                        g2.drawLine((int)currX, (int)currY, (int)hitX, (int)hitY); 
                        remainLen -= tHit; currX = hitX; currY = hitY;
                        if (tHit == tX) dirX *= -1; else dirY *= -1; bounces++;
                    } else {
                        g2.drawLine((int)currX, (int)currY, (int)nextX, (int)nextY); currX = nextX; currY = nextY; remainLen = 0;
                    }
                }
                g2.setStroke(new BasicStroke(1)); double finalAngle = Math.atan2(dirY, dirX); int arrowSize = 16; 
                int[] xP = { (int)currX, (int)(currX - arrowSize * Math.cos(finalAngle - Math.PI / 6)), (int)(currX - arrowSize * Math.cos(finalAngle + Math.PI / 6)) };
                int[] yP = { (int)currY, (int)(currY - arrowSize * Math.sin(finalAngle - Math.PI / 6)), (int)(currY - arrowSize * Math.sin(finalAngle + Math.PI / 6)) };
                g2.fillPolygon(xP, yP, 3);
            }
            g2.setStroke(new BasicStroke(1)); 
        }

        g2.setColor(new Color(0, 0, 0, 180)); g2.fillRect(0, 50, width, 50); g2.setFont(new Font("Verdana", Font.BOLD, 26));
        if (bPhase == BattlePhase.PLAYER_TURN || bPhase == BattlePhase.AIMING || bPhase == BattlePhase.PLAYER_MOVING) {
            g2.setColor(new Color(100, 255, 100)); g2.drawString(">>> PLAYER TURN <<<", 240, 85);
        } else {
            g2.setColor(new Color(255, 100, 100)); g2.drawString(">>> BOSS TURN <<<", 260, 85);
        }
        drawUI(g2);
    }

    private void drawUI(Graphics2D g2) {
        g2.setColor(new Color(0, 0, 0, 160)); g2.fillRoundRect(15, 120, 180, 140, 15, 15);
        g2.setFont(new Font("Arial", Font.BOLD, 14)); g2.setColor(new Color(200, 200, 200)); g2.drawString("SKILLS ( Z / X )", 45, 145);
        int uiY = 160;
        for (int i = 0; i < myChickens.size(); i++) {
            HeroChicken c = myChickens.get(i);
            c.drawUI(g2, 25, uiY, (i == 0) ? "Z" : "X"); uiY += 45;
        }
    }

    private void drawEndScreen(Graphics2D g2, String text, Color color) {
        g2.setColor(new Color(0, 0, 0, 180)); g2.fillRect(0, 0, width, height); g2.setFont(new Font("Verdana", Font.BOLD, 70));
        g2.setColor(Color.BLACK); g2.drawString(text, 155, 305); g2.setColor(color); g2.drawString(text, 150, 300);
        if ((System.currentTimeMillis() / 500) % 2 == 0) {
            g2.setFont(new Font("Arial", Font.BOLD, 20)); g2.setColor(Color.WHITE); g2.drawString("PRESS [ ENTER ] TO RESTART", 245, 400);
        }
    }

    @Override public void mousePressed(MouseEvent e) {
        int mx = e.getX(), my = e.getY();
        if (state == GameState.MENU) {
            if (mx >= 300 && mx <= 500 && my >= 300 && my <= 355) state = GameState.SELECT; 
            if (mx >= 300 && mx <= 500 && my >= 400 && my <= 455) System.exit(0); 
        } else if (state == GameState.SELECT) {
            for (int i = 0; i < availableChickens.size(); i++) {
                if (mx >= 120 + (i * 220) && mx <= 280 + (i * 220) && my >= 180 && my <= 450) {
                    if (myChickens.size() < 2 && !myChickens.contains(availableChickens.get(i))) myChickens.add(availableChickens.get(i).cloneHero());
                }
            }
            if (myChickens.size() >= 2) state = GameState.EXPLORE;
        } else if (state == GameState.BATTLE && bPhase == BattlePhase.PLAYER_TURN) {
            if (!SwingUtilities.isLeftMouseButton(e)) return; 
            for (HeroChicken c : myChickens) {
                if (c.isAlive() && c.isCollidingWithPoint(mx, my, c.size)) {
                    selectedChicken = c; bPhase = BattlePhase.AIMING; dragX = mx; dragY = my; break; 
                }
            }
        } else if (state == GameState.VICTORY || state == GameState.GAMEOVER) { resetGame(); }
    }

    @Override public void mouseDragged(MouseEvent e) { if (state == GameState.BATTLE && bPhase == BattlePhase.AIMING) { dragX = e.getX(); dragY = e.getY(); } }

    @Override public void mouseReleased(MouseEvent e) {
        if (state == GameState.BATTLE && bPhase == BattlePhase.AIMING && selectedChicken != null) {
            double cx = selectedChicken.getX() + selectedChicken.size / 2.0, cy = selectedChicken.getY() + selectedChicken.size / 2.0;
            double dx = cx - e.getX(), dy = cy - e.getY(), dragDist = Math.hypot(dx, dy);
            if (SwingUtilities.isRightMouseButton(e) || dragDist < 15) { selectedChicken = null; bPhase = BattlePhase.PLAYER_TURN; return; }
            
            double maxPower = 22.0, rawPower = dragDist * 0.035 * selectedChicken.speed, finalPower = Math.min(rawPower, maxPower), angle = Math.atan2(dy, dx);
            selectedChicken.vx = finalPower * Math.cos(angle); selectedChicken.vy = finalPower * Math.sin(angle);
            selectedChicken = null; bPhase = BattlePhase.PLAYER_MOVING; 
        }
    }

    @Override public void keyPressed(KeyEvent e) {
        if (state == GameState.EXPLORE) {
            if (e.getKeyCode() == KeyEvent.VK_W) up = true; if (e.getKeyCode() == KeyEvent.VK_S) down = true;
            if (e.getKeyCode() == KeyEvent.VK_A) left = true; if (e.getKeyCode() == KeyEvent.VK_D) right = true;
        } else if (state == GameState.BATTLE && bPhase == BattlePhase.PLAYER_TURN) {
            if (e.getKeyCode() == KeyEvent.VK_Z && myChickens.size() > 0) myChickens.get(0).activateSkill();
            if (e.getKeyCode() == KeyEvent.VK_X && myChickens.size() > 1) myChickens.get(1).activateSkill();
        } else if (state == GameState.VICTORY || state == GameState.GAMEOVER) {
            if (e.getKeyCode() == KeyEvent.VK_ENTER) resetGame();
        }
    }
    @Override public void keyReleased(KeyEvent e) {
        if (e.getKeyCode() == KeyEvent.VK_W) up = false; if (e.getKeyCode() == KeyEvent.VK_S) down = false;
        if (e.getKeyCode() == KeyEvent.VK_A) left = false; if (e.getKeyCode() == KeyEvent.VK_D) right = false;
    }
