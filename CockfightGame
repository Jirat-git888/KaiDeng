        drawGradientBG(g2, new Color(20, 30, 50), new Color(10, 15, 25)); 
        g2.setFont(new Font("Verdana", Font.BOLD, 55));
        g2.setColor(new Color(0, 0, 0, 150)); g2.drawString("COCKFIGHT BATTLE", 95, 205); 
        g2.setColor(new Color(255, 220, 50)); g2.drawString("COCKFIGHT BATTLE", 90, 200);

        GradientPaint btnGreen = new GradientPaint(300, 300, new Color(50, 200, 50), 300, 350, new Color(20, 150, 20));
        g2.setPaint(btnGreen); g2.fillRoundRect(300, 300, 200, 55, 25, 25);
        g2.setColor(Color.WHITE); g2.setFont(new Font("Arial", Font.BOLD, 22)); g2.drawString("START GAME", 325, 336);
        
        GradientPaint btnRed = new GradientPaint(300, 400, new Color(220, 50, 50), 300, 450, new Color(150, 20, 20));
        g2.setPaint(btnRed); g2.fillRoundRect(300, 400, 200, 55, 25, 25);
