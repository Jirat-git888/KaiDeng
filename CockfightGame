class TrailNode {
    double x, y; int alpha;
    public TrailNode(double x, double y) { this.x = x; this.y = y; this.alpha = 100; }
}

abstract class Entity {
    public double x, y, vx, vy;
    public int size;
    protected Color color;
    
    public int getX() { return (int)x; }
    public int getY() { return (int)y; }
    public boolean isCollidingWith(Entity other) {
        double dx = (this.x + this.size/2.0) - (other.x + other.size/2.0);
        double dy = (this.y + this.size/2.0) - (other.y + other.size/2.0);
        return Math.sqrt(dx * dx + dy * dy) < (this.size + other.size) / 2.0;
    }
    public boolean isCollidingWithPoint(int px, int py, int tolerance) {
        double cx = x + size/2.0, cy = y + size/2.0;
        return Math.sqrt((px-cx)*(px-cx) + (py-cy)*(py-cy)) < tolerance;
    }
    public abstract void draw(Graphics g);
}

abstract class Chicken extends Entity {
    protected String name; protected int hp, maxHp, attack; protected double speed; 
    protected int cooldown = 0;
    protected Portal lastWarpedPortal = null; // --- เปลี่ยนมาใช้การจำหลุมวาร์ปแทนการนับเวลา ---
    protected Image img;
    protected ArrayList<TrailNode> trails = new ArrayList<>(); 

    public Chicken(String name, int hp, int attack, double speed, Color color, String imgPath) {
        this.name = name; this.hp = this.maxHp = hp; this.attack = attack; this.speed = speed; this.color = color; this.size = 30;
        this.img = new ImageIcon(imgPath).getImage();
    }

    public boolean isAlive() { return hp > 0; }
    public boolean isMoving() { return Math.abs(vx) > 0.1 || Math.abs(vy) > 0.1; }
    public void spawnInArena(int startX, int startY) { this.x = startX; this.y = startY; this.vx = 0; this.vy = 0; trails.clear(); lastWarpedPortal = null; }

    public void updatePhysics(Rectangle arena, ArrayList<EggMine> mines) {
        if (cooldown > 0) cooldown--;
        
        if (isMoving() && Math.hypot(vx, vy) > 4.0) trails.add(new TrailNode(x, y));
        
        x += vx; y += vy;
        vx *= 0.94; vy *= 0.94;
        if (Math.abs(vx) < 0.2) vx = 0; if (Math.abs(vy) < 0.2) vy = 0;
        
        if (x <= arena.x) { x = arena.x; vx *= -1; }
        if (x + size >= arena.x + arena.width) { x = arena.x + arena.width - size; vx *= -1; }
        if (y <= arena.y) { y = arena.y; vy *= -1; }
        if (y + size >= arena.y + arena.height) { y = arena.y + arena.height - size; vy *= -1; }
        
        Iterator<TrailNode> iter = trails.iterator();
        while (iter.hasNext()) { TrailNode t = iter.next(); t.alpha -= 8; if (t.alpha <= 0) iter.remove(); }
    }
    
    public void handleObstacles(ArrayList<Obstacle> obstacles) {
        for (Obstacle obs : obstacles) {
            if (isCollidingWith(obs)) {
                double dx = (this.x + this.size/2.0) - (obs.x + obs.size/2.0), dy = (this.y + this.size/2.0) - (obs.y + obs.size/2.0);
                double dist = Math.hypot(dx, dy); if (dist == 0) { dx = 1; dist = 1; }
                double nx = dx / dist, ny = dy / dist, dot = vx * nx + vy * ny;
                if (dot < 0) { 
                    vx = vx - 2 * dot * nx; vy = vy - 2 * dot * ny; 
                    GameEngine.spawnParticles(obs.x + obs.size/2, obs.y + obs.size/2, Color.WHITE, 4); GameEngine.shakeTimer = 1;
                }
                double overlap = ((this.size + obs.size)/2.0) - dist;
                if (overlap > 0) { this.x += nx * overlap; this.y += ny * overlap; }
            }
        }
    }
    
    public void handlePortals(ArrayList<Portal> portals) {
        // เช็คว่าตัวหลุดออกจากรัศมีหลุมล่าสุดที่เพิ่งโผล่ออกมาหรือยัง
        if (lastWarpedPortal != null && !isCollidingWith(lastWarpedPortal)) {
            lastWarpedPortal = null;
        }
        
        for (Portal p : portals) {
            if (p == lastWarpedPortal) continue; // ถ้ายังไม่ออกมา ห้ามโดนดูดกลับ!
            
            if (isCollidingWith(p) && p.linkedPortal != null) {
                this.x = p.linkedPortal.x + (p.linkedPortal.size - this.size) / 2.0;
                this.y = p.linkedPortal.y + (p.linkedPortal.size - this.size) / 2.0;
                this.lastWarpedPortal = p.linkedPortal; // จำหลุมปลายทางไว้
                
                GameEngine.spawnParticles(this.x + size/2, this.y + size/2, Color.CYAN, 15);
                GameEngine.shakeTimer = 3;
                break;
            }
        }
    }

    public void takeDamage(int amount, ArrayList<DamageText> texts) {
        hp -= amount; texts.add(new DamageText((int)x + size/2, (int)y, "-" + amount, Color.RED)); cooldown = 30; 
    }

    @Override
    public void draw(Graphics g) {
        Graphics2D g2 = (Graphics2D) g;
        for (TrailNode t : trails) { g2.setColor(new Color(color.getRed(), color.getGreen(), color.getBlue(), t.alpha)); g2.fillOval((int)t.x, (int)t.y, size, size); }
        if (img != null && img.getWidth(null) > 0) g2.drawImage(img, (int)x, (int)y, size, size, null); else { g2.setColor(color); g2.fillOval((int)x, (int)y, size, size); }
        g2.setColor(new Color(255, 50, 50)); g2.fillRoundRect((int)x, (int)y - 12, size, 6, 3, 3);
        g2.setColor(new Color(50, 255, 50)); g2.fillRoundRect((int)x, (int)y - 12, Math.max(0, size * hp / maxHp), 6, 3, 3);
    }
}

abstract class HeroChicken extends Chicken {
    protected boolean hasDoubleDamage = false; protected int skillCooldown = 0, maxSkillCooldown;
    protected Image skillIcon; protected boolean skillActive = false; protected int stuckTimer = 0; 

    public HeroChicken(String name, int hp, int attack, double speed, Color color, String imgPath, String skillImgPath, int maxCD) {
        super(name, hp, attack, speed, color, imgPath); this.maxSkillCooldown = maxCD; this.skillIcon = new ImageIcon(skillImgPath).getImage();
    }

    public abstract HeroChicken cloneHero(); 
    public void activateSkill() { if (hp > 0 && skillCooldown <= 0 && !skillActive) { skillActive = true; skillCooldown = maxSkillCooldown; applySkillEffect(); } }
    public void resetSkill() { if (skillActive) { skillActive = false; removeSkillEffect(); } }
    protected abstract void applySkillEffect(); protected abstract void removeSkillEffect();

    public void followTarget(int targetX, int targetY) {
        double dx = targetX - x, dy = targetY - y; if (Math.sqrt(dx * dx + dy * dy) > 50) { x += dx * 0.05; y += dy * 0.05; }
    }

    public void checkCollisionWith(BossChicken boss, ArrayList<DamageText> texts) {
        double dx = (this.x + this.size/2.0) - (boss.x + boss.size/2.0), dy = (this.y + this.size/2.0) - (boss.y + boss.size/2.0);
        double dist = Math.hypot(dx, dy), minDist = (this.size + boss.size) / 2.0;

        if (dist <= minDist + 2.0) {
            stuckTimer++;
            if (stuckTimer >= 90) { 
                if (dist == 0) { dx = 1; dy = 0; dist = 1; } 
                double pushForce = 12.0; 
                this.vx = (dx / dist) * pushForce; this.vy = (dy / dist) * pushForce;
                boss.vx = -(dx / dist) * pushForce; boss.vy = -(dy / dist) * pushForce;
                stuckTimer = 0; return; 
            }
        } else { stuckTimer = 0; }

        if (dist < minDist) {
            if (this.cooldown <= 0 && boss.cooldown <= 0) {
                int dmg = this.attack; if (this.hasDoubleDamage) { dmg *= 2; this.hasDoubleDamage = false; }
                boss.takeDamage(dmg, texts); this.takeDamage(boss.attack, texts);
                
                GameEngine.shakeTimer = 15; GameEngine.hitStopTimer = 5;
                GameEngine.spawnParticles(this.x + this.size/2, this.y + this.size/2, this.color, 15);
                GameEngine.spawnParticles(boss.x + boss.size/2, boss.y + boss.size/2, boss.color, 15);
                
                handleBossCollision(boss); 
            }
            double overlap = minDist - dist;
            if (overlap > 0) { this.x += (dx/dist) * overlap/2.0; this.y += (dy/dist) * overlap/2.0; boss.x -= (dx/dist) * overlap/2.0; boss.y -= (dy/dist) * overlap/2.0; }
        }
    }
    
    protected void handleBossCollision(BossChicken boss) {
        double tempVx = this.vx, tempVy = this.vy; this.vx = boss.vx; this.vy = boss.vy; boss.vx = tempVx; boss.vy = tempVy;
    }

    public void drawPortrait(Graphics g, int px, int py, int pSize) {
        Graphics2D g2 = (Graphics2D) g;
        g2.setColor(new Color(255, 255, 255, 20)); g2.fillRoundRect(px - 15, py - 60, pSize + 30, pSize + 190, 20, 20);
        g2.setColor(new Color(255, 255, 255, 80)); g2.drawRoundRect(px - 15, py - 60, pSize + 30, pSize + 190, 20, 20);
        g2.setColor(Color.WHITE); g2.setFont(new Font("Verdana", Font.BOLD, 20)); g2.drawString(name, px + (pSize/2) - (g2.getFontMetrics().stringWidth(name)/2), py - 20);
        if (img != null && img.getWidth(null) > 0) g2.drawImage(img, px, py, pSize, pSize, null); else { g2.setColor(color); g2.fillOval(px, py, pSize, pSize); }
        g2.setFont(new Font("Arial", Font.BOLD, 15)); int textY = py + pSize + 30, line = 25;
        g2.setColor(new Color(150, 255, 150)); g2.drawString("HP: " + hp, px + 5, textY);
        g2.setColor(new Color(255, 150, 150)); g2.drawString("ATK: " + attack, px + 5, textY + line);
        g2.setColor(new Color(150, 200, 255)); g2.drawString("SPD: " + speed, px + 5, textY + (line * 2));
    }

    public void drawUI(Graphics g, int px, int py, String keyStr) {
        Graphics2D g2 = (Graphics2D) g;
        if (skillIcon != null && skillIcon.getWidth(null) > 0) g2.drawImage(skillIcon, px, py, 32, 32, null); else { g2.setColor(color.darker()); g2.fillRoundRect(px, py, 32, 32, 8, 8); }
        g2.setColor(Color.WHITE); g2.drawRoundRect(px, py, 32, 32, 8, 8); 
        g2.setColor(Color.LIGHT_GRAY); g2.fillRoundRect(px+20, py-8, 20, 20, 5, 5);
        g2.setColor(Color.BLACK); g2.setFont(new Font("Arial", Font.BOLD, 11)); g2.drawString(keyStr, px+26, py+6);
        g2.setColor(color); g2.setFont(new Font("Arial", Font.BOLD, 13)); g2.drawString(name, px+42, py+10);
        
        g2.setColor(Color.DARK_GRAY); g2.fillRoundRect(px+42, py+16, 100, 10, 4, 4); g2.setColor(new Color(50, 200, 255)); 
        int cdWidth = (maxSkillCooldown == 0) ? 100 : 100 - (skillCooldown * 100 / maxSkillCooldown); g2.fillRoundRect(px+42, py+16, cdWidth, 10, 4, 4);
        
        if (skillActive) { g2.setColor(Color.MAGENTA); g2.setFont(new Font("Arial", Font.BOLD, 11)); g2.drawString("ACTIVE!", px+148, py+25); 
        } else if (skillCooldown <= 0 && isAlive()) { g2.setColor(Color.YELLOW); g2.setFont(new Font("Arial", Font.BOLD, 11)); g2.drawString("READY!", px+148, py+25); 
        } else if (isAlive()) { g2.setColor(Color.WHITE); g2.setFont(new Font("Arial", Font.PLAIN, 11)); g2.drawString(skillCooldown + " Turns", px+148, py+25); }
    }
    
    @Override public void draw(Graphics g) {
        if (hasDoubleDamage) { Graphics2D g2 = (Graphics2D) g; g2.setColor(new Color(255, 50, 50, 120)); g2.fillOval((int)x - 8, (int)y - 8, size + 16, size + 16); }
        super.draw(g);
    }
}

