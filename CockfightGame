    @Override public HeroChicken cloneHero() { return new BalancedChicken(); }
    @Override protected void applySkillEffect() { lastMineX = x; lastMineY = y; }
    @Override protected void removeSkillEffect() { }
    
    @Override public void updatePhysics(Rectangle arena, ArrayList<EggMine> mines) {
        super.updatePhysics(arena, mines);
        if (skillActive && isMoving()) {
            if (Math.hypot(x - lastMineX, y - lastMineY) > 70) {
                mines.add(new EggMine(x + size/2.0 - 10, y + size/2.0 - 10)); lastMineX = x; lastMineY = y;
            }
        }
    }
}

class EggMine extends Entity {
    public EggMine(double x, double y) { this.x = x; this.y = y; this.size = 20; }
    @Override public void draw(Graphics g) {
        Graphics2D g2 = (Graphics2D) g;
        g2.setColor(Color.WHITE); g2.fillOval((int)x, (int)y, size, size);
        g2.setColor(new Color(255, 100, 100)); g2.fillOval((int)x+4, (int)y+4, size-8, size-8);
    }
}

class BossChicken extends Chicken {
    public boolean enraged = false; // --- โหมดโกรธ ---
    
    public BossChicken(int x, int y) { super("Void Boss", 400, 15, 5.0, new Color(180, 0, 180), "boss.png"); this.size = 40; this.x = x; this.y = y; }
    
    @Override
    public void takeDamage(int amount, ArrayList<DamageText> texts) {
        super.takeDamage(amount, texts);
        // ทริกเกอร์โหมดโกรธเมื่อเลือดต่ำกว่า 40%
        if (!enraged && hp <= maxHp * 0.4 && hp > 0) {
            enraged = true;
            this.size += 15; // ตัวใหญ่ขึ้น
            this.attack += 5; // ตีแรงขึ้น
            this.color = new Color(220, 20, 20); // เปลี่ยนเป็นสีแดง
            texts.add(new DamageText((int)x, (int)y - 20, "ENRAGED!", Color.RED));
            GameEngine.spawnParticles(x + size/2.0, y + size/2.0, Color.RED, 40);
        }
    }
    
    public void drawExploration(Graphics g) {
        if (img != null && img.getWidth(null) > 0) g.drawImage(img, (int)x, (int)y, size, size, null); else { g.setColor(color); g.fillOval((int)x, (int)y, size, size); }
        g.setColor(Color.WHITE); g.setFont(new Font("Arial", Font.BOLD, 12)); g.drawString("NPC (Boss)", (int)x - 10, (int)y - 10);
    }
}

class BuffItem extends Entity {
    GameEngine.BuffType type;
    public BuffItem(int x, int y) {
        this.x = x; this.y = y; this.size = 20; this.type = GameEngine.BuffType.values()[new Random().nextInt(3)];
        if (type == GameEngine.BuffType.HEAL) color = new Color(50, 255, 50); else if (type == GameEngine.BuffType.DAMAGE_X2) color = new Color(255, 50, 50); else if (type == GameEngine.BuffType.SPEED_UP) color = new Color(50, 200, 255);
    }
    public void applyBuffTo(HeroChicken c, ArrayList<DamageText> texts) {
        if (type == GameEngine.BuffType.HEAL) { c.hp = Math.min(c.hp + 50, c.maxHp); texts.add(new DamageText(c.getX(), c.getY(), "+50", color)); } else if (type == GameEngine.BuffType.DAMAGE_X2) c.hasDoubleDamage = true; else if (type == GameEngine.BuffType.SPEED_UP) c.speed += 2.0; 
    }
    @Override public void draw(Graphics g) {
        Graphics2D g2 = (Graphics2D) g; g2.setColor(new Color(color.getRed(), color.getGreen(), color.getBlue(), 80)); g2.fillOval((int)x - 8, (int)y - 8, size + 16, size + 16);
        g2.setColor(color); g2.fillOval((int)x, (int)y, size, size); g2.setColor(Color.BLACK); g2.setFont(new Font("Arial", Font.BOLD, 12));
        if (type == GameEngine.BuffType.HEAL) g2.drawString("+", (int)x + 6, (int)y + 15); if (type == GameEngine.BuffType.DAMAGE_X2) g2.drawString("x2", (int)x + 3, (int)y + 15); if (type == GameEngine.BuffType.SPEED_UP) g2.drawString(">>", (int)x + 3, (int)y + 15);
    }
}

class DamageText {
    int x, y; String text; Color color; int life = 60;
    public DamageText(int x, int y, String text, Color color) { this.x = x; this.y = y; this.text = text; this.color = color; }
    public void update() { y -= 1; life--; }
    public boolean isDead() { return life <= 0; }
    public void draw(Graphics g) {
        Graphics2D g2 = (Graphics2D) g; g2.setFont(new Font("Verdana", Font.BOLD, 20));
        int alpha = Math.max(0, Math.min(255, (int) (255.0 * life / 60))); g2.setColor(new Color(0, 0, 0, alpha)); g2.drawString(text, x+2, y+2); 
        g2.setColor(new Color(color.getRed(), color.getGreen(), color.getBlue(), alpha)); g2.drawString(text, x, y);
    }
}
